# Polygon wallet private key (with 0x prefix)
POLYGON_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Alchemy RPC URL for Polygon mainnet (sub-10ms target)
ALCHEMY_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# Set to "false" for live trading with real orders
TEST_MODE=true

# Set to "true" to launch Streamlit dashboard on port 8501
ENABLE_DASHBOARD=false

# Redis URL for Bayesian model state persistence across restarts (optional)
# Preserves winning edge continuity when the bot restarts
REDIS_URL=redis://localhost:6379/0

# SMTP alerting (optional) — sends email on drawdown/latency warnings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=

# ngrok auth token for remote dashboard access (optional)
# Get a free token at https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
